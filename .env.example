# Application Configuration
PORT=3001
CLIENT_URL=http://127.0.0.1:5173
NODE_ENV=development

# Authentication
JWT_SECRET=replace_with_a_32_character_minimum_secret
ADMIN_EMAIL=admin@akatech.com

# Google OAuth 2.0
GOOGLE_CLIENT_ID=your_google_client_id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your_google_client_secret
GOOGLE_CALLBACK_URL=http://127.0.0.1:5173

# Neon Postgres
DATABASE_URL=postgresql://user:password@host/db?sslmode=require
# Compatibility fallback for existing local env files.
VITE_DATABASE_URL=postgresql://user:password@host/db?sslmode=require

# Email / SMTP for password reset
EMAIL_SERVICE=gmail
EMAIL_USER=your_email@example.com
EMAIL_PASS=your_email_app_password
EMAIL_FROM=AkaTech IT Solutions <your_email@example.com>
# Or use SMTP_* instead of EMAIL_*:
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=

# Payment Webhooks (Optional)
PAYSTACK_SECRET_KEY=sk_test_or_live_key
STRIPE_WEBHOOK_SECRET=whsec_...
